# =====================================================================
# Copia este archivo como .env.local y completa los valores reales.
# NUNCA subas .env.local al repositorio (ya está en .gitignore).
# =====================================================================

# Panel de Supabase > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Panel de Supabase > Project Settings > API > Project API keys > anon public
# Esta clave es SEGURA de exponer al navegador: el acceso real lo
# controla Row Level Security (RLS) en la base de datos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# URL pública donde correrá la app (usada en metadata SEO y en los
# enlaces de los correos de Supabase Auth: confirmación, reset password).
# En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# SOLO SERVIDOR — NUNCA debe llevar el prefijo NEXT_PUBLIC_
# Panel de Supabase > Project Settings > API > Project API keys > service_role
# Esta clave se salta RLS por completo. Úsala solo si implementas tareas
# administrativas en src/lib/supabase/admin.ts. Si no la necesitas,
# puedes dejarla vacía.
# ---------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
